<!-- NetWasm.Sdk builds the regular .NET targets as usual and adds netwasm0.1 for NetWasm consumers -->
<Project Sdk="NetWasm.Sdk/0.8.1">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;netwasm0.1</TargetFrameworks>
    <Version>0.5.0</Version>
    <Nullable>enable</Nullable>
    <PackageId>Wivuu.Sprog</PackageId>
    <Authors>Erik O'Leary</Authors>
    <Company>Wivuu</Company>
    <Product>Wivuu Sprog</Product>
    <Description>Sprog (Danish for 'Language') string parsing library written for C# 11+ and .NET.</Description>
    <AssemblyName>Wivuu.Sprog</AssemblyName>
    <RootNamespace>Wivuu.Sprog</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PackageReleaseNotes>
    - Add netwasm0.1 target for NetWasm (https://github.com/zion-sati/NetWasm) consumers
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/onionhammer/Wivuu.Sprog</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>c#;parse;parser;core;dotnet core</PackageTags>
    <RepositoryUrl>https://github.com/onionhammer/Wivuu.Sprog.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
