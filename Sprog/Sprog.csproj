<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>0.7.0</Version>
    <Nullable>enable</Nullable>
    <PackageId>Wivuu.Sprog</PackageId>
    <Authors>Erik O'Leary</Authors>
    <Company>Wivuu</Company>
    <Product>Wivuu Sprog</Product>
    <Description>Sprog (Danish for 'Language') string parsing library written for C# 11+ and .NET.</Description>
    <AssemblyName>Wivuu.Sprog</AssemblyName>
    <RootNamespace>Wivuu.Sprog</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PackageReleaseNotes>
    - Drop the netwasm0.1 target, which NetWasm 0.15 deprecates: NetWasm projects that target
      net10.0-netwasm use the net10.0 build. Projects that still target netwasm0.1 can stay on 0.6.0
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/onionhammer/Wivuu.Sprog</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>c#;parse;parser;core;dotnet core</PackageTags>
    <RepositoryUrl>https://github.com/onionhammer/Wivuu.Sprog.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
